# SBALT Dev Orchestrator — local environment example.
# Copy to .env and fill in. NEVER commit .env.
#
# Phase 0 stores NO secrets in SQLite. These variables are read from the
# environment only when the corresponding integration is enabled, which is
# not the case in Phase 0.

# Where durable orchestrator state lives (SQLite file).
# Defaults to ./.dev-orch/state.sqlite when unset.
DEV_ORCH_DB_PATH=

# Policy file. Defaults to ./config/policy.yaml, falling back to
# ./config/policy.example.yaml when no local policy exists.
DEV_ORCH_POLICY_PATH=

# Absolute path to a target project checkout the orchestrator may READ.
# Phase 0 never mutates a target project.
SBALT_REPO_PATH=

# --- Not used in Phase 0. Present so operators know where they will go. ---
# Reasoning component (GPT Coordinator). Phase 0 uses a deterministic stub.
# OPENAI_API_KEY=
# Worker provider credentials. Phase 0 uses a fake worker.
# ANTHROPIC_API_KEY=
# GitHub access for PR/CI adapters. Phase 0 has no GitHub integration.
# GITHUB_TOKEN=
