{
  "name": "sbalt-dev-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "SBALT Development Orchestrator \u2014 durable task/lane orchestration for multi-agent software development workflows.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "bin": {
    "dev-orch": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev-orch": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "commander": "^12.1.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
